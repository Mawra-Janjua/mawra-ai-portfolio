# Live demo backends for the four automation project pages.
# Leave a pair empty and that project's page shows "Live demo not connected yet".
# These are read only on the server (src/app/api/demo/[project]/route.ts) and never sent to the browser.

EMAIL_AGENT_URL=
EMAIL_AGENT_API_KEY=

LEAD_AGENT_URL=
LEAD_AGENT_API_KEY=

INVOICE_API_URL=
INVOICE_API_KEY=

MEETING_API_URL=
MEETING_API_KEY=

# Public address of the site (canonical links, sharing previews, sitemap), e.g. https://your-domain.com
# Optional on Vercel: the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=
